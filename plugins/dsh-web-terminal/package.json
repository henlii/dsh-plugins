{
  "name": "dsh-web-terminal",
  "version": "0.1.0",
  "description": "DeepSeek Harness web plugin: user-only PTY terminals in the sidebar. Agent bash stays on the official one-shot ctx.shell.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src"
  ],
  "license": "MIT"
}
