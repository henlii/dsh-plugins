{
  "name": "@henlii/dsh-web-auth",
  "version": "0.1.0",
  "description": "DSH plugin: password authentication + trust for dsh web LAN/Tailscale access. Non-loopback /api and WebSocket traffic requires a password login; once authenticated, the privileged settings/credentials plane works over LAN.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src"
  ],
  "license": "MIT"
}
