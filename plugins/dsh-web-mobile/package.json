{
  "name": "@henlii/dsh-web-mobile",
  "version": "0.2.2",
  "description": "DSH plugin: phone chrome for the shipped dsh web shell. The left and right columns become overlay drawers (no permanent rail), Settings becomes a two-level page stack, and the chat gets phone spacing.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henlii/dsh-plugins.git",
    "directory": "plugins/dsh-web-mobile"
  },
  "license": "MIT"
}
