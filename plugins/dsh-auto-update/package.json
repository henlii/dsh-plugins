{
  "name": "@henlii/dsh-auto-update",
  "version": "0.1.0",
  "description": "DSH plugin: one-click update for the DeepSeek Harness runtime — check npm latest/next dist-tags, upgrade to the preview build or roll back to the stable one, with a guarded background upgrade (separate process, verify-then-restart, rollback script).",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henlii/dsh-plugins.git",
    "directory": "plugins/dsh-auto-update"
  },
  "license": "MIT"
}
